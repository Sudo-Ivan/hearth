# ============================================================================
#  Hearth settings for the Docker Compose bundle
#
#  Copy this file to .env, fill in the required values and run docker compose
#  up -d. Settings that start with # are optional and use their default until
#  you remove the #.
#
#  The optional compose files change how Hearth runs. To use one, list it
#  after docker-compose.yml in COMPOSE_FILE, such as
#  COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml.
#
#    docker-compose.proxy.yml           for your own reverse proxy
#    tunnel.compose.yml                 for a tunnel
#    external-object-store.compose.yml  for your own object store
#    ipv6.compose.yml                   for IPv6 on Hearth's network
#    docker-compose.crowdsec.yml        for CrowdSec on the edge
#
#  If you move this instance to hearthctl later with hearthctl takeover, the
#  hearthctl line under each setting shows the command that changes it.
# ============================================================================


# ============================================================================
#  REQUIRED
#
#  Fill these in before the first start.
# ============================================================================

# docker-compose.yml refuses to start without this line. Keep it as it is.
FLUXER_SETTINGS_LOADED=true

# domain
#   The domain Hearth runs on.
#   type:     hostname
#   example:  chat.example.com
#   hearthctl:hearthctl config set domain
FLUXER_DOMAIN=


# ============================================================================
#  FIRST ADMIN ACCOUNT
# ============================================================================

# setup token
#   The account that signs up with this token becomes Hearth's first admin.
#   Use 32 to 256 characters, such as the output of openssl rand -hex 32. If
#   you leave it empty, the api service makes a token and writes it to its log
#   once, on its first start. docker compose logs api shows it.
#   type:     secret
FLUXER_SETUP_TOKEN=


# ============================================================================
#  SECRETS
#
#  Fill in each empty value before the first start, and keep a copy of .env
#  somewhere safe.
# ============================================================================

# These have fixed values. Keep them as they are unless a setting below tells
# you to change one.
FLUXER_S3_ACCESS_KEY=hearth
LIVEKIT_API_KEY=hearth

# Generate each value with this command. Do this once before the first start
# and keep them the same after that, because your stored data depends on them.
#   openssl rand -hex 32
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
FLUXER_S3_SECRET_KEY=
LIVEKIT_API_SECRET=

# Generate each value with this command.
#   openssl rand -hex 32
FLUXER_SUDO_MODE_SECRET=
FLUXER_CONNECTION_INITIATION_SECRET=
FLUXER_PROFILE_PSEUDONYM_SECRET=
FLUXER_GATEWAY_RPC_AUTH_TOKEN=
FLUXER_ERLANG_COOKIE=
FLUXER_MEDIA_PROXY_SECRET_KEY=
FLUXER_ADMIN_SECRET_KEY_BASE=
FLUXER_ADMIN_OAUTH_CLIENT_SECRET=

# Generate the value with this command.
#   openssl rand -base64 32
FLUXER_MEDIA_PROXY_UPLOAD_RELAY_SECRET_BASE64=

# This is the key pair for push notifications. These commands print the public
# key and then the private key. Do this once before the first start and keep
# the pair the same after that, because your stored data depends on it.
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
#   openssl ec -in vapid.pem -pubout -outform DER | tail -c 65 | base64 |
#     tr '/+' '_-' | tr -d '=\n'
#   openssl ec -in vapid.pem -outform DER | tail -c +8 | head -c 32 |
#     base64 | tr '/+' '_-' | tr -d '=\n'
#   rm vapid.pem
FLUXER_VAPID_PUBLIC_KEY=
FLUXER_VAPID_PRIVATE_KEY=


# ============================================================================
#  EDGE AND HTTPS
#
#  By default Hearth listens on ports 80 and 443 and gets its own HTTPS
#  certificate for your domain.
# ============================================================================

# edge.bind
#   The address your reverse proxy or tunnel connects to.
#   type:     address
#   default:  127.0.0.1:8080 with docker-compose.proxy.yml
#             127.0.0.1:80 with tunnel.compose.yml
#   hearthctl:hearthctl config set edge.bind
# FLUXER_EDGE_BIND=

# edge.http_port
#   The port Hearth listens on for HTTP.
#   type:     port
#   default:  80
#   hearthctl:hearthctl config set edge.http_port
# FLUXER_HTTP_PORT=

# edge.https_port
#   The port Hearth listens on for HTTPS. If people connect to this port
#   directly, set FLUXER_PUBLIC_PORT to the same port.
#   type:     port
#   default:  443
#   hearthctl:hearthctl config set edge.https_port
# FLUXER_HTTPS_PORT=

# edge.public_port
#   The port people use in Hearth's address, when it differs from the one
#   Hearth listens on.
#   type:     port
#   default:  443
#   hearthctl:hearthctl config set edge.public_port
# FLUXER_PUBLIC_PORT=

# edge.trusted_proxies
#   Proxies whose client address headers Hearth trusts. Separate entries with
#   spaces.
#   type:     list
#   default:  127.0.0.1/32
#             private_ranges with docker-compose.proxy.yml
#             private_ranges with tunnel.compose.yml
#   hearthctl:hearthctl config set edge.trusted_proxies
# FLUXER_EDGE_TRUSTED_PROXIES=


# ============================================================================
#  VOICE AND VIDEO
#
#  Calls connect directly to this machine on these ports, even when Hearth is
#  behind your own proxy.
# ============================================================================

# voice.tcp_port
#   The TCP port for voice and video.
#   type:     port
#   default:  7881
#   hearthctl:hearthctl config set voice.tcp_port
# FLUXER_LIVEKIT_TCP_PORT=

# voice.udp_port
#   The UDP port for voice and video.
#   type:     port
#   default:  7882
#   hearthctl:hearthctl config set voice.udp_port
# FLUXER_LIVEKIT_UDP_PORT=

# voice.public_ip
#   The public IP address voice and video use, when Hearth can't find it by
#   itself. Set FLUXER_LIVEKIT_NODE_IP to the address and
#   FLUXER_LIVEKIT_USE_EXTERNAL_IP to false.
#   type:     ip
#   hearthctl:hearthctl config set voice.public_ip
# FLUXER_LIVEKIT_NODE_IP=
# FLUXER_LIVEKIT_USE_EXTERNAL_IP=


# ============================================================================
#  OBJECT STORAGE
#
#  Leave these unset to use the bundled object store. To use your own
#  S3-compatible store, set them and add external-object-store.compose.yml to
#  COMPOSE_FILE.
# ============================================================================

# storage.endpoint
#   Your own S3-compatible object store.
#   type:     url
#   default:  http://seaweedfs:8333
#   hearthctl:hearthctl config set storage.endpoint
# FLUXER_S3_ENDPOINT=

# storage.public_endpoint
#   The object store address browsers use, when it differs from the one Hearth
#   uses.
#   type:     url
#   hearthctl:hearthctl config set storage.public_endpoint
# FLUXER_S3_PUBLIC_ENDPOINT=

# storage.region
#   The object store region.
#   type:     text
#   default:  us-east-1
#   hearthctl:hearthctl config set storage.region
# FLUXER_S3_REGION=

# storage.path_style
#   Whether the object store needs path-style addresses.
#   type:     bool
#   default:  true
#   hearthctl:hearthctl config set storage.path_style
# FLUXER_S3_FORCE_PATH_STYLE=

# storage.access_key
#   The object store access key. For your own store, change
#   FLUXER_S3_ACCESS_KEY under SECRETS above.
#   type:     text
#   hearthctl:hearthctl config set storage.access_key

# storage.secret_key
#   The object store secret key. For your own store, change
#   FLUXER_S3_SECRET_KEY under SECRETS above.
#   type:     secret
#   hearthctl:hearthctl config set storage.secret_key


# ============================================================================
#  OUTGOING PROXY
# ============================================================================

# network.http_proxy
#   The proxy Hearth uses for outgoing HTTP requests.
#   type:     url
#   hearthctl:hearthctl config set network.http_proxy
# HTTP_PROXY=

# network.https_proxy
#   The proxy Hearth uses for outgoing HTTPS requests.
#   type:     url
#   hearthctl:hearthctl config set network.https_proxy
# HTTPS_PROXY=

# network.no_proxy
#   Hosts Hearth connects to without the proxy. Separate hosts with commas.
#   type:     list
#   hearthctl:hearthctl config set network.no_proxy
# NO_PROXY=


# ============================================================================
#  IMAGES
#
#  Set one to use your own mirror or another version. Hearth's own images are
#  pinned to the release in docker-compose.yml.
# ============================================================================

# images.edge
#   The image for edge.
#   type:     image
#   default:  docker.io/library/caddy:2.11-alpine
#   hearthctl:hearthctl config set images.edge
# FLUXER_CADDY_IMAGE=

# images.livekit
#   The image for livekit.
#   type:     image
#   default:  docker.io/livekit/livekit-server:v1.12.0
#   hearthctl:hearthctl config set images.livekit
# FLUXER_LIVEKIT_IMAGE=

# images.meilisearch
#   The image for meilisearch.
#   type:     image
#   default:  docker.io/getmeili/meilisearch:v1.53
#   hearthctl:hearthctl config set images.meilisearch
# FLUXER_MEILISEARCH_IMAGE=

# images.nats
#   The image for nats.
#   type:     image
#   default:  docker.io/library/nats:2.14-alpine
#   hearthctl:hearthctl config set images.nats
# FLUXER_NATS_IMAGE=

# images.postgres
#   The image for postgres.
#   type:     image
#   default:  docker.io/library/postgres:16-alpine
#   hearthctl:hearthctl config set images.postgres
# FLUXER_POSTGRES_IMAGE=

# images.seaweedfs
#   The image for seaweedfs.
#   type:     image
#   default:  docker.io/chrislusf/seaweedfs:4.47
#   hearthctl:hearthctl config set images.seaweedfs
# FLUXER_SEAWEEDFS_IMAGE=

# images.valkey
#   The image for valkey.
#   type:     image
#   default:  docker.io/valkey/valkey:9.1-alpine
#   hearthctl:hearthctl config set images.valkey
# FLUXER_VALKEY_IMAGE=
