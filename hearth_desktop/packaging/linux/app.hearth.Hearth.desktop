# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=Hearth
GenericName=Instant Messenger
Comment=Instant messaging and VoIP
Exec=app.hearth.Hearth %U
TryExec=app.hearth.Hearth
Icon=app.hearth.Hearth
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=app.hearth.Hearth
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/hearth;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=app.hearth.Hearth --hearth-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=app.hearth.Hearth --hearth-task=new-dm %U
