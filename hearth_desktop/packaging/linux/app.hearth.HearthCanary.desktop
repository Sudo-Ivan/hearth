# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=Hearth Canary
GenericName=Instant Messenger
Comment=Canary build of Hearth
Exec=app.hearth.HearthCanary %U
TryExec=app.hearth.HearthCanary
Icon=app.hearth.HearthCanary
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=app.hearth.HearthCanary
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/hearth;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=app.hearth.HearthCanary --hearth-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=app.hearth.HearthCanary --hearth-task=new-dm %U
